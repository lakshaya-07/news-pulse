# Copy to .env at the repo root. Never commit .env.

# Postgres connection string (local docker-compose or Neon).
DATABASE_URL=postgresql://newspulse:newspulse@localhost:5432/newspulse

# Node API
PORT=43101
# Allowed browser origin for CORS (the frontend URL in production).
FRONTEND_URL=http://localhost:43100
CORS_ORIGIN=http://localhost:43100
# Interpreter the API spawns for POST /api/ingest/trigger.
PYTHON_BIN=python3
# Clustering strictness (cosine similarity 0–1).
SIMILARITY_THRESHOLD=0.28
# How many days of articles to recluster each run.
CLUSTER_DAYS=3

# Next.js frontend. Prefer same-origin proxy (/news-api) so the browser
# works behind port forwarding. Set API_INTERNAL_URL to the Express host.
NEXT_PUBLIC_API_URL=/news-api
API_INTERNAL_URL=http://127.0.0.1:43101
